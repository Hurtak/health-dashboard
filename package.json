{
  "name": "daily-strength",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "check": "vp check --deny-warnings",
    "check:fix": "vp check --fix --deny-warnings",
    "type-check": "vp check --no-fmt --no-lint",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix --deny-warnings",
    "fmt": "vp fmt --check",
    "fmt:fix": "vp fmt --write",
    "validate": "npm run check && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
